{
  "name": "tollgate",
  "version": "1.0.0",
  "description": "A Redis-backed, networked rate-limiting service with atomic token bucket and sliding-window algorithms.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/lua', 'dist/lua', { recursive: true })\"",
    "start": "node dist/server.js",
    "typecheck:loadtest": "tsc --noEmit -p tsconfig.loadtest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anupam9919/Tollgate.git"
  },
  "keywords": [
    "redis",
    "rate-limiting",
    "typescript",
    "express",
    "lua",
    "api",
    "load-testing"
  ],
  "author": "Anupam Singh",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/anupam9919/Tollgate/issues"
  },
  "homepage": "https://github.com/anupam9919/Tollgate#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "redis": "^6.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/k6": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
